# Local only: copy to .env and fill values.
# Do NOT set SPRING_PROFILES_ACTIVE=prod in local .env unless you intend to.
#
# Production: do not rely on this file in Java.
# Inject the same keys as OS/systemd/Docker environment variables, plus:
#   SPRING_PROFILES_ACTIVE=prod

API_KEY=
# Embedding（向量检索 / 入库），与主 Chat 的 API_KEY 分开，便于单独测 LLM 降级
EMBEDDING_API_KEY=
# Optional: secondary LLM for fallback (defaults to API_KEY / qwen-turbo if omitted)
SECONDARY_API_KEY=
SECONDARY_MODEL_NAME=qwen-turbo

DB_USERNAME=
DB_PASSWORD=
JWT_SECRET_KEY=

# Required when spring.profiles.active=prod (application-prod.yml)
DB_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
SERVER_PORT=
